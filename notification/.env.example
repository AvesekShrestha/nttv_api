# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=notification_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=notification-service

# ── Auth microservice ─────────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:8001

# ── JWT (must match the secret used by the Auth service to sign tokens) ───────
JWT_SECRET_KEY=change-me-shared-secret
JWT_ALGORITHM=HS256

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=youremail@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=youremail@gmail.com
EMAIL_USE_TLS=True

# ── Firebase Cloud Messaging ──────────────────────────────────────────────────
# Path to your Firebase service-account JSON (do NOT commit this file)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json
