# PostgreSQL
DATABASE_URL=postgresql+asyncpg://notification_user:change-me@localhost:5432/nttv_notification

# Ticket API
TICKET_SERVICE_URL=http://localhost:8001
TICKET_API_TIMEOUT_SECONDS=10

# Authentication API
AUTHENTICATION_SERVICE_URL=http://localhost:8002
AUTHENTICATION_API_TIMEOUT_SECONDS=10

# Browser frontend origins: JSON array
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=notification-service

KAFKA_TICKET_TOPIC=ticket.events
KAFKA_AUTH_TOPIC=auth.events

KAFKA_TICKET_DLQ_TOPIC=ticket.events.dlq
KAFKA_AUTH_DLQ_TOPIC=auth.events.dlq

KAFKA_MAX_RETRIES=3
KAFKA_RETRY_DELAY_SECONDS=5

# SMTP: STARTTLS on port 587
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=sender@example.com
EMAIL_HOST_PASSWORD=replace-with-app-password
DEFAULT_FROM_EMAIL=sender@example.com
EMAIL_USE_TLS=true

# Delivery worker
DELIVERY_WORKER_INTERVAL=60

# Use a separate active account with permission to read user records.
# Empty values cause an interactive prompt on first login.
DELIVERY_WORKER_EMAIL=
DELIVERY_WORKER_PASSWORD=
