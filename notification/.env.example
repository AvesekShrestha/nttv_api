# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user_name:password@localhost:5432/database_name
ALBEMIC_DATABASE_URL=postgresql+asyncpg://user_name:password@localhost:5432/database_name

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=notification-service
KAFKA_TICKET_TOPIC=ticket.events

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=youremail@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=youremail@gmail.com
EMAIL_USE_TLS=True

# ── Firebase Cloud Messaging ──────────────────────────────────────────────────
# Path to your Firebase service-account JSON (do NOT commit this file)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json

# ── JWT (must match the secret used by the Auth service to sign tokens) ───────
JWT_SECRET_KEY=<same key Auth service uses>
